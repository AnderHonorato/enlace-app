{
  "name": "enlace-app",
  "version": "1.0.0",
  "private": true,
  "description": "Only Nós — diário privado para casais, com visual de papel e tinta.",
  "scripts": {
    "dev": "next dev -H 0.0.0.0 -p 3007",
    "dev:local": "next dev -p 3007",
    "build": "node scripts/preparar-prisma-ambiente.mjs && prisma generate && next build",
    "build:check": "set NEXT_DIST_DIR=.next-build&& next build",
    "preview": "set NEXT_DIST_DIR=.next-preview&& next dev -p 3008",
    "start": "next start",
    "lint": "next lint",
    "db:push": "prisma db push",
    "db:safe": "node scripts/atualizar-banco-seguro.mjs",
    "db:importar": "node scripts/importar-banco-atual.mjs",
    "db:testar-importacao": "node scripts/testar-importacao-banco.mjs",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "postinstall": "prisma generate",
    "musicas": "node scripts/gerar-musicas.mjs",
    "musicas:dividir": "node scripts/dividir-catalogo-musical.mjs",
    "quiz:check": "tsx scripts/valida-quiz.ts",
    "arquitetura:verificar": "node scripts/verificar-arquitetura.mjs"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@types/leaflet": "^1.9.21",
    "bcryptjs": "^2.4.3",
    "clsx": "^2.1.1",
    "date-fns": "^3.6.0",
    "framer-motion": "^11.11.17",
    "jose": "^5.9.6",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.454.0",
    "nanoid": "^5.0.8",
    "next": "^14.2.35",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.5.4",
    "web-push": "^3.6.7",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.17.6",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/web-push": "^3.6.4",
    "autoprefixer": "^10.4.20",
    "ngrok": "^5.0.0-beta.2",
    "postcss": "^8.4.49",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.15",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
