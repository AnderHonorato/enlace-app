# Copie para .env e ajuste os valores.
# Desenvolvimento local pode continuar usando SQLite.
DATABASE_URL="file:./dev.db"

# Segurança — use valores aleatórios diferentes entre si.
# Gere cada um, por exemplo, com: openssl rand -base64 48
SESSION_SECRET="gere-um-segredo-exclusivo-para-sessoes"
DATA_ENCRYPTION_SECRET="gere-outro-segredo-exclusivo-para-dados"

# Compatibilidade temporária com instalações antigas. Se já existe APP_SECRET,
# mantenha-o durante a migração de dados cifrados; projetos novos não precisam.
# APP_SECRET="segredo-antigo-apenas-para-migracao"

# Rate limit distribuído opcional (Upstash Redis REST). Em produção com mais de
# uma instância é recomendado configurar os dois valores.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Só ative em infraestrutura onde o proxy remove/substitui X-Forwarded-For.
# TRUST_PROXY_HEADERS=false

# Conta que pode consultar o histórico administrativo de localização.
# Quando omitido, instalações existentes reconhecem o usuário chamado Ander.
# ENLACE_ADMIN_EMAIL=ander@exemplo.com

NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Produção (Vercel/Hostinger): use PostgreSQL e o domínio público.
# DATABASE_URL="postgresql://usuario:SENHA@host:5432/postgres"
# NEXT_PUBLIC_APP_URL="https://onlynos.site"
# Nunca salve a senha real do banco neste arquivo ou no GitHub.

# (Opcional) Chaves de IA globais — usadas como fallback quando o usuário
# não cadastrou a própria chave nas Configurações. Cada usuário pode usar a sua.
# OPENAI_API_KEY=
# DEEPSEEK_API_KEY=
# ANTHROPIC_API_KEY=

# (Opcional) Notificações push — gere com: npx web-push generate-vapid-keys --json
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:voce@exemplo.com

# (Opcional) Spotify — crie um app em https://developer.spotify.com/dashboard
# SPOTIFY_CLIENT_ID=
# SPOTIFY_CLIENT_SECRET=

# Transcrição gratuita prioritária (Groq Whisper)
# GROQ_API_KEY=
