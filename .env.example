# Copie para .env e ajuste os valores.
DATABASE_URL="file:./dev.db"
APP_SECRET="gere-um-segredo-aleatorio-forte"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# (Opcional) Chaves de IA globais — usadas como fallback quando o usuário
# não cadastrou a própria chave nas Configurações. Cada usuário pode usar a sua.
# OPENAI_API_KEY=
# DEEPSEEK_API_KEY=
# ANTHROPIC_API_KEY=

# (Opcional) Notificações push — gere com: npx web-push generate-vapid-keys --json
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:voce@exemplo.com

# (Opcional) Spotify — crie um app em https://developer.spotify.com/dashboard
# SPOTIFY_CLIENT_ID=
# SPOTIFY_CLIENT_SECRET=

# Transcrição gratuita prioritária (Groq Whisper)
# GROQ_API_KEY=
